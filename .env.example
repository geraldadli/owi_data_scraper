# Copy the entries you need into .env. Do not overwrite an existing .env.
# .env is local and gitignored. Never put real credentials in this example.

# Used by the YouTube collector. Leave empty to skip YouTube.
YOUTUBE_API_KEY=

# Optional X account placeholders for your manual login reference.
# The notebook does NOT read these fields or submit credentials automatically.
# You can leave them empty and use your password manager in Chromium instead.
X_USERNAME=
X_PASSWORD=

# Optional Instagram/Facebook manual-login reference; not read by the collector.
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
FACEBOOK_EMAIL=
FACEBOOK_PASSWORD=
