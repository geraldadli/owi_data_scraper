# Copy the entries you need into .env. Do not overwrite an existing .env.
# .env is local and gitignored. Never put real credentials in this example.

# Used by the YouTube collector. Leave empty to skip YouTube.
YOUTUBE_API_KEY=

# Optional automatic X login. Leave blank to log in manually.
# Complete 2FA/CAPTCHA/verification yourself in the opened browser.
X_USERNAME=
X_PASSWORD=

# Optional automatic Instagram/Facebook login. Leave blank for manual login.
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
FACEBOOK_EMAIL=
FACEBOOK_PASSWORD=
